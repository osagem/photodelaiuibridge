# ============================================================
#  外部 / 自备发布密钥配置模板
# ============================================================
#  用途：让 build.sh 用你自己的 keystore 给桥 App 签名（本项目默认方案不启用此路径）
#
#      cp keystore.external.properties.template keystore.external.properties
#      #  → 编辑 keystore.external.properties，填上路径、别名与口令
#      ./build.sh release keystore.external.properties
#
#  ⚠ keystore.external.properties 里是【明文口令】
#    · 已在 .gitignore 中排除，切勿提交或分享
#    · 用完可以删掉，或放到项目目录之外
# ============================================================

# keystore 文件路径。Windows 路径建议用正斜杠 /；含空格时引号必须保留。
# 也可直接写相对/绝对路径，例如： storeFile="/path/to/your-release.keystore"
storeFile=your-release.keystore

# keystore 类型：PKCS12 或 JKS（Java 9+ 默认 PKCS12）
storeType=PKCS12

# 密钥别名（创建 keystore 时用 -alias 指定的名字）
keyAlias=your-key-alias

# ↓↓↓↓ 填写口令（两行通常相同；若不同则分别填）↓↓↓↓
storePassword=
keyPassword=
