<!-- 按钮描边/文字颜色选择器。
     ★ 与 photoDel4rokidglasses 工程 res/color/button_stroke_color_selector.xml 保持**逐字一致**：
       常态 40% 绿 → 选中/聚焦 80% 绿 → 按下 100% 绿。
     （该文件同时用于 stroke 与 textColor，所以描边与文字永远同色。） -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下状态 -->
    <item android:state_pressed="true" android:color="@color/rgrcolor_pressed" />
    <!-- 选中状态 -->
    <item android:state_selected="true" android:color="@color/rgrcolor_selected" />
    <item android:state_focused="true" android:color="@color/rgrcolor_selected" />
    <!-- 常态 -->
    <item android:color="@color/rgrcolor_normal" />
</selector>
