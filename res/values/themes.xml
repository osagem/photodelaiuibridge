<!--
  控制台主题：无标题栏 + 纯黑窗口底。
  · NoActionBar 去掉头部标题行（原为系统 DeviceDefault 主题自带的 ActionBar）
  · windowBackground 与 colorBackground 均设纯黑 → 与 Rokid Glasses 系统界面融为一体，视觉上"无背景"
-->
<resources>
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
        <!-- API 31+ 的系统启动闪屏：显式纯黑，杜绝冷启动 / Activity 重启时漏出默认浅色 -->
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
    </style>
</resources>
