<!--
  声明本应用支持的语言（Android 13 / API 33+ 的 per-app language 机制读取此文件）。
  配合 AndroidManifest 的 android:localeConfig 使用，用户可在
  「设置 → 应用 → 照片删除智能体服务 → 语言」里单独为 App 指定语言。

  API < 33 的系统会忽略这个声明，届时仍按「系统语言 → 资源限定目录」的经典规则解析
  （中文系统 → res/values-zh/，其它 → res/values/ 英文兜底）。
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="zh" />
</locale-config>
